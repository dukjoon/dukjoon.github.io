---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_MAP } from '../../constants/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const categoryMeta = CATEGORY_MAP[post.data.category];
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="max-w-none">
    <header class="mb-8 border-b border-gray-800 pb-6">
      <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400 tabular-nums mb-2 font-mono">
        <time datetime={post.data.pubDatetime.toISOString()}>
          {post.data.pubDatetime.toISOString().slice(0, 10)}
        </time>
        <a
          href={`/categories/${categoryMeta.id}/`}
          class="text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-900/50 px-1.5 py-0.5 rounded hover:border-emerald-700 transition"
        >
          {categoryMeta.label}
        </a>
        {post.data.draft && (
          <span class="bg-yellow-900/60 text-yellow-300 px-1.5 py-0.5 rounded text-[10px] font-mono">
            DRAFT
          </span>
        )}
      </div>
      <h1 class="text-2xl md:text-3xl font-bold text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>
      <p class="text-gray-400 text-sm mt-3 leading-relaxed">
        {post.data.description}
      </p>
      <div class="flex flex-wrap gap-1.5 mt-4">
        {post.data.tags.map((tag) => (
          <span class="text-xs font-mono text-blue-400 bg-blue-950/40 border border-blue-900/50 px-2 py-0.5 rounded">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="markdown-body space-y-4 text-[#e6edf3] leading-relaxed [&_h1]:text-2xl [&_h1]:font-bold [&_h1]:mt-8 [&_h1]:mb-4 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:mt-6 [&_h2]:mb-3 [&_h2]:border-b [&_h2]:border-gray-800 [&_h2]:pb-2 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:mt-5 [&_h3]:mb-2 [&_p]:my-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_li]:my-1 [&_blockquote]:border-l-4 [&_blockquote]:border-blue-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-gray-400 [&_pre]:p-4 [&_pre]:rounded-lg [&_pre]:bg-[#161b22] [&_pre]:overflow-x-auto [&_pre]:my-4 [&_code]:font-mono [&_code]:text-sm [&_:not(pre)>code]:bg-gray-800 [&_:not(pre)>code]:px-1.5 [&_:not(pre)>code]:py-0.5 [&_:not(pre)>code]:rounded [&_hr]:border-gray-800 [&_hr]:my-8 [&_table]:w-full [&_table]:border-collapse [&_th]:border [&_th]:border-gray-800 [&_th]:p-2 [&_th]:bg-gray-900 [&_td]:border [&_td]:border-gray-800 [&_td]:p-2">
      <Content />
    </div>
  </article>
</Layout>
