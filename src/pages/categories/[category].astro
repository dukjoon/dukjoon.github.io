---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import {
  CATEGORIES,
  type CategoryId,
  type CategoryMeta,
} from '../../constants/categories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  const counts = Object.fromEntries(
    CATEGORIES.map((cat) => [
      cat.id,
      allPosts.filter((post) => post.data.category === cat.id).length,
    ])
  ) as Record<CategoryId, number>;

  return CATEGORIES.map((category) => {
    const categoryPosts = allPosts
      .filter((post) => post.data.category === category.id)
      .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

    return {
      params: { category: category.id },
      props: {
        category,
        posts: categoryPosts,
        counts,
      },
    };
  });
}

interface Props {
  category: CategoryMeta;
  posts: CollectionEntry<'blog'>[];
  counts: Record<CategoryId, number>;
}

const { category, posts, counts } = Astro.props;
---

<Layout title={category.label} description={category.description}>
  <section class="space-y-8">
    <div class="flex flex-wrap gap-2">
      <a
        href="/"
        class="text-xs font-mono px-2.5 py-1 rounded border border-gray-800 text-gray-400 hover:text-white hover:border-gray-700 transition"
      >
        All
      </a>
      {CATEGORIES.map((item) => {
        const isCurrent = item.id === category.id;
        return (
          <a
            href={`/categories/${item.id}/`}
            class:list={[
              'inline-flex items-center gap-1.5 text-xs font-mono px-2.5 py-1 rounded border transition',
              isCurrent
                ? 'text-blue-400 bg-blue-950/40 border-blue-800'
                : 'text-gray-400 bg-[#161b22]/50 border-gray-800 hover:text-white hover:border-gray-700',
            ]}
          >
            <span>{item.label}</span>
            <span class="tabular-nums text-[11px] text-gray-500">({counts[item.id]})</span>
          </a>
        );
      })}
    </div>

    <header class="border-b border-gray-800 pb-6 space-y-2">
      <div class="flex items-center justify-between gap-3">
        <h1 class="text-2xl font-bold text-white tracking-tight font-mono">
          {category.label}
        </h1>
        <span class="text-xs font-mono tabular-nums text-gray-400 bg-[#161b22] border border-gray-800 px-2.5 py-1 rounded">
          {posts.length} {posts.length === 1 ? 'post' : 'posts'}
        </span>
      </div>
      <p class="text-sm text-gray-400 leading-relaxed">{category.description}</p>
    </header>

    {posts.length === 0 ? (
      <div class="rounded-lg border border-dashed border-gray-800 bg-[#161b22]/40 p-8 text-center space-y-3">
        <p class="text-sm text-gray-300 leading-relaxed">{category.emptyMessage}</p>
        <div>
          <a
            href="/"
            class="inline-block text-xs font-mono text-blue-400 hover:text-blue-300 transition"
          >
            &larr; 전체 글 목록으로 돌아가기
          </a>
        </div>
      </div>
    ) : (
      <div class="divide-y divide-gray-800">
        {posts.map((post) => (
          <article class="py-6 group">
            <div class="flex items-center gap-2 text-xs text-gray-400 tabular-nums mb-1.5 font-mono">
              <time datetime={post.data.pubDatetime.toISOString()}>
                {post.data.pubDatetime.toISOString().slice(0, 10)}
              </time>
              {post.data.draft && (
                <span class="bg-yellow-900/60 text-yellow-300 px-1.5 py-0.5 rounded text-[10px] font-mono">
                  DRAFT
                </span>
              )}
            </div>
            <h2 class="text-lg font-semibold text-white group-hover:text-blue-400 transition">
              <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
            </h2>
            <p class="text-sm text-gray-400 mt-2 line-clamp-2 leading-relaxed">
              {post.data.description}
            </p>
            <div class="flex flex-wrap gap-1.5 mt-3">
              {post.data.tags.map((tag) => (
                <span class="text-xs font-mono text-blue-400 bg-blue-950/40 border border-blue-900/50 px-2 py-0.5 rounded">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Layout>
