---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, CATEGORY_MAP, type CategoryId } from '../constants/categories';

const posts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

posts.sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());

const categoryCounts = Object.fromEntries(
  CATEGORIES.map((category) => [
    category.id,
    posts.filter((post) => post.data.category === category.id).length,
  ])
) as Record<CategoryId, number>;
---

<Layout title="Home">
  <section class="space-y-8">
    <div class="space-y-2">
      <h1 class="text-2xl font-bold text-white tracking-tight">Recent Posts</h1>
      <p class="text-sm text-gray-400">로컬 메모와 커밋 로그 기반으로 자동 생성·사후 검수된 엔지니어링 기록입니다.</p>
    </div>

    <div class="rounded-lg border border-gray-800 bg-[#161b22]/60 p-4 space-y-3">
      <div class="flex items-center justify-between text-xs font-mono text-gray-400">
        <span>CATEGORIES</span>
        <a href="/categories/" class="text-blue-400 hover:text-blue-300 transition">
          전체 보기 &rarr;
        </a>
      </div>
      <div class="flex flex-wrap gap-2">
        {CATEGORIES.map((category) => {
          const count = categoryCounts[category.id];
          return (
            <a
              href={`/categories/${category.id}/`}
              class:list={[
                'inline-flex items-center gap-1.5 text-xs font-mono px-2.5 py-1 rounded border transition',
                count > 0
                  ? 'text-[#e6edf3] bg-[#0d1117] border-gray-700 hover:border-blue-500 hover:text-blue-400'
                  : 'text-gray-500 bg-[#0d1117]/60 border-gray-800 hover:border-gray-700 hover:text-gray-300',
              ]}
            >
              <span>{category.label}</span>
              <span class="tabular-nums text-[11px] text-gray-500">({count})</span>
            </a>
          );
        })}
      </div>
    </div>

    <div class="divide-y divide-gray-800">
      {posts.length === 0 ? (
        <p class="py-8 text-gray-500 text-sm font-mono">등록된 글이 없습니다.</p>
      ) : (
        posts.map((post) => {
          const categoryMeta = CATEGORY_MAP[post.data.category];
          return (
            <article class="py-6 group">
              <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400 tabular-nums mb-1.5 font-mono">
                <time datetime={post.data.pubDatetime.toISOString()}>
                  {post.data.pubDatetime.toISOString().slice(0, 10)}
                </time>
                <a
                  href={`/categories/${categoryMeta.id}/`}
                  class="text-xs font-mono text-emerald-400 bg-emerald-950/40 border border-emerald-900/50 px-1.5 py-0.5 rounded hover:border-emerald-700 transition"
                >
                  {categoryMeta.label}
                </a>
                {post.data.draft && (
                  <span class="bg-yellow-900/60 text-yellow-300 px-1.5 py-0.5 rounded text-[10px] font-mono">
                    DRAFT
                  </span>
                )}
              </div>
              <h2 class="text-lg font-semibold text-white group-hover:text-blue-400 transition">
                <a href={`/posts/${post.slug}/`}>{post.data.title}</a>
              </h2>
              <p class="text-sm text-gray-400 mt-2 line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {post.data.tags.map((tag) => (
                  <span class="text-xs font-mono text-blue-400 bg-blue-950/40 border border-blue-900/50 px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </div>
            </article>
          );
        })
      )}
    </div>
  </section>
</Layout>
